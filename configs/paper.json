{
  "model": {
    "name": "Qwen/Qwen2.5-0.5B-Instruct",
    "revision": "main",
    "device": "cuda:0",
    "load_in_4bit": true,
    "dtype": "auto",
    "max_length": 256,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "v_proj"]
  },
  "data": {
    "dataset": "allenai/ai2_arc",
    "subset": "ARC-Easy",
    "revision": "main",
    "source_split": "train",
    "train_size": 500,
    "validation_size": 100,
    "test_size": 100,
    "split_seed": 42,
    "root": "data/arc_easy"
  },
  "generation": {
    "model": "Qwen/Qwen2.5-7B-Instruct",
    "verifier_model": "Qwen/Qwen2.5-7B-Instruct",
    "embedding_model": "sentence-transformers/all-mpnet-base-v2",
    "similarity_threshold": 0.85,
    "max_new_tokens": 128,
    "max_retries": 3
  },
  "heads": {
    "layers": [16, 17, 18, 19, 20, 21, 22, 23],
    "subset_size": 100,
    "ratio": 0.2,
    "strategy": "sensitive",
    "seed": 42,
    "eps": 1e-12
  },
  "training": {
    "method": "paraattn",
    "representation": "region",
    "seed": 42,
    "epochs": 3,
    "batch_size": 4,
    "gradient_accumulation": 4,
    "learning_rate": 0.0002,
    "weight_decay": 0.01,
    "regularization_weight": 0.1,
    "max_grad_norm": 1.0
  },
  "evaluation": {
    "batch_size": 4,
    "bootstrap_samples": 2000,
    "bootstrap_seed": 42,
    "diagnostic_layers": [16, 17, 18, 19, 20, 21, 22, 23],
    "latency_warmup": 3,
    "latency_samples": 20
  }
}
